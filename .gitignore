# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Node / Astro
node_modules/
site/dist/
site/.astro/

# Raw downloads are archived as GitHub Release assets, never committed
data/raw/
*.tmp

# Secrets
.env
.env.*

# OS
.DS_Store

# Site build outputs (regenerated by `make build`)
site/src/data/generated/
site/public/data/
site/public/calendar.ics
site/public/status-map.json
site/public/downloads/

# Morning newsletter fact packs and previews (regenerated; drafts in newsletter/drafts are committed)
newsletter/packs/

# Private reference material (e.g. internal notes we replicate from public data). Kept locally, never committed.
private/
site/screenshots/

# Wrangler local dev state (scheduler/)
.wrangler/
