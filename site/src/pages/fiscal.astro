---
import Base from "../layouts/Base.astro";
import LineChart from "../components/LineChart.astro";
import PeriodTable from "../components/PeriodTable.astro";
import { series, latest } from "../lib/data.js";
import { num, period } from "../lib/format.js";
const fd = latest(series("cga_fiscal_deficit_pct_be"));
const fdPrev = latest(series("cga_fiscal_deficit_pct_be_prev"));
const gst = latest(series("gst_gross_collections"));
import fs from "node:fs";
const budget = JSON.parse(fs.readFileSync("src/data/generated/budget.json", "utf8"));
const record = budget.record ?? {};
// Twin deficits: both shown as deficits (positive = deficit), so the current account is flipped.
const pts = (id, sign = 1) => series(id).data.map((d) => [d[0], Math.round(sign * d[1] * 100) / 100]);
const twin = { years: 40, reference: { target: 0 }, series: [
  { label: "Centre's fiscal deficit", curve: "linear", points: pts("centre_gfd_pct_gdp") },
  { label: "Current account deficit", curve: "linear", points: pts("cab_pct_gdp_fy", -1) },
] };
const fdAt = (y) => series("centre_gfd_pct_gdp").data.find((d) => d[0] === `${y}-04-01`)?.[1];
const cadAt = (y) => -series("cab_pct_gdp_fy").data.find((d) => d[0] === `${y}-04-01`)?.[1];
const fdRec = record["Fiscal deficit, % of GDP"] ?? [];
const fdChart = { years: 12, series: [["be", "Budget Estimate"], ["re", "Revised Estimate"], ["actual", "Actual"]].map(([k, label]) => (
  { label, curve: "linear", points: fdRec.filter((r) => r[k] !== null).map((r) => [r.period, r[k]]) })) };
const recYears = (record["Capital expenditure"] ?? []).map((r) => r.fy);
const recAt = (item, fy) => (record[item] ?? []).find((r) => r.fy === fy) ?? {};
const miss = (r) => (r.actual == null || r.be == null ? null : 100 * (r.actual / r.be - 1));
const signed = (v, d = 1) => (v === null ? "" : `${v > 0 ? "+" : ""}${num(v, d)}`);
// Progress against the Budget, as CGA prints it (no calculation here).
const vsBE = [["Revenue receipts", "cga_revenue_receipts"], ["Tax revenue (net to Centre)", "cga_net_tax"],
  ["Non-tax revenue", "cga_nontax"], ["Other receipts", "cga_other_receipts"], ["Total receipts", "cga_total_receipts"],
  ["Revenue expenditure", "cga_revenue_expenditure"], ["Capital expenditure", "cga_capex"],
  ["Total expenditure", "cga_total_expenditure"], ["Fiscal deficit", "cga_fiscal_deficit"]]
  .map(([label, p]) => ({ label, fytd: latest(series(`${p}_fytd`)), pct: latest(series(`${p}_pct_be`)), prev: latest(series(`${p}_pct_be_prev`)) }));
const vsPeriod = vsBE[0].pct.period;
---
<Base current="fiscal" title="Fiscal">
  <h1>Fiscal</h1>
  <p class="lede" data-pagefind-meta="summary">Is the Union government on track for its budgeted deficit? By the end of {period(fd.period, "M")} the fiscal deficit had reached {num(fd.value, 1)}% of the year's Budget Estimate, against {num(fdPrev.value, 1)}% at the same point last year. Monthly accounts from the Controller General of Accounts; GST from the GST portal.</p>

  <div class="grid2">
    <LineChart title="Fiscal deficit, year to date, as % of the Budget Estimate" subtitle="Each financial year starts in April; March is the full year (% of Revised Estimates)"
      lines={[{ id: "cga_fiscal_deficit_pct_be", label: "This year" }, { id: "cga_fiscal_deficit_pct_be_prev", label: "Same month, previous year" }]} years={2} />
    <LineChart title="Capital expenditure, year to date, as % of the Budget Estimate" subtitle="March is the full year (% of Revised Estimates)"
      lines={[{ id: "cga_capex_pct_be", label: "This year" }, { id: "cga_capex_pct_be_prev", label: "Same month, previous year" }]} years={2} />
  </div>

  {budget.rows.length > 0 && <>
  <h2 id="budget">Union Budget {budget.year} at a glance</h2>
  <div class="scroll"><table class="data">
    <thead><tr><th>₹ lakh crore</th>{budget.columns.map((c) => <th>{c}</th>)}<th>BE vs last RE</th></tr></thead>
    <tbody>
      {budget.rows.map((r) => <tr><td>{r.item}</td>{r.values.map((v) => <td>{v === null ? "–" : r.ratio ? `${num(v, 1)}%` : num(v, 2)}</td>)}
        <td>{r.change_pct === null ? "" : `${r.change_pct > 0 ? "+" : ""}${num(r.change_pct, 1)}%`}</td></tr>)}
    </tbody>
  </table></div>
  <p class="chart-sub">BE: Budget Estimates, presented with the Budget; RE: Revised Estimates for the year then ending; Actuals: the outturn as printed in the Budget. "BE vs last RE" is the planned change on the year before's revised figure (site calculation). Effective capital expenditure is capital expenditure plus grants-in-aid for creating capital assets, as defined in the Budget. Deficit ratios are % of GDP as printed. Source: Ministry of Finance, Budget at a Glance. Spending by ministry: <a href="/tools/budget/">Budget explorer →</a></p>
  </>}

  {fdRec.length > 2 && <>
  <h2 id="budget-record">What was budgeted, and what happened</h2>
  <figure class="chart">
    <p class="chart-title">Union fiscal deficit: budgeted, revised and actual</p>
    <p class="chart-sub">% of GDP, by financial year (2020 = 2020-21)</p>
    <div class="plot" data-chart={JSON.stringify(fdChart)}></div>
    <figcaption><span>Source: Ministry of Finance, Budget at a Glance (each year's Budget, from 2019-20).</span></figcaption>
  </figure>
  <div class="scroll"><table class="data">
    <thead><tr><th rowspan="2">Year</th><th colspan="3">Fiscal deficit, % of GDP</th><th colspan="3">Capital expenditure, ₹ lakh crore</th><th colspan="3">Net tax revenue, ₹ lakh crore</th></tr>
      <tr><th>BE</th><th>RE</th><th>Actual</th><th>BE</th><th>Actual</th><th>vs BE</th><th>BE</th><th>Actual</th><th>vs BE</th></tr></thead>
    <tbody>
      {recYears.map((fy) => {
        const f = recAt("Fiscal deficit, % of GDP", fy), c = recAt("Capital expenditure", fy), t = recAt("Tax revenue (net to Centre)", fy);
        const cell = (v, d) => (v == null ? "–" : num(v, d));
        return <tr><td>{fy}</td><td>{cell(f.be, 1)}</td><td>{cell(f.re, 1)}</td><td><b>{cell(f.actual, 1)}</b></td>
          <td>{cell(c.be, 2)}</td><td><b>{cell(c.actual, 2)}</b></td><td class={miss(c) < 0 ? "neg" : ""}>{miss(c) === null ? "" : `${signed(miss(c))}%`}</td>
          <td>{cell(t.be, 2)}</td><td><b>{cell(t.actual, 2)}</b></td><td class={miss(t) < 0 ? "neg" : ""}>{miss(t) === null ? "" : `${signed(miss(t))}%`}</td></tr>;
      })}
    </tbody>
  </table></div>
  <p class="chart-sub">Each Budget prints the Budget Estimate (BE) for the coming year, the Revised Estimate (RE) for the year ending, and the Actual for two years back; we read every Budget from 2019-20 (archived PDFs) and the current one, so Actuals start in 2017-18 and each new Budget adds a year. "vs BE" is how far the outturn was from the plan (site calculation). In the two election years (2019-20, 2024-25) the BE is from the full Budget presented in July, not the interim Budget of February. Source: Ministry of Finance, Budget at a Glance.</p>
  </>}

  <h2 id="accounts">Union government accounts, year to date</h2>
  <PeriodTable heading="₹ lakh crore, April to the month shown" n={6} digits={2} rows={[
    { id: "cga_total_receipts_fytd" }, { id: "cga_revenue_receipts_fytd", indent: true }, { id: "cga_net_tax_fytd", indent: true },
    { id: "cga_total_expenditure_fytd" }, { id: "cga_revenue_expenditure_fytd", indent: true }, { id: "cga_interest_fytd", indent: true },
    { id: "cga_capex_fytd", indent: true },
    { id: "cga_fiscal_deficit_fytd" }, { id: "cga_revenue_deficit_fytd" }, { id: "cga_primary_deficit_fytd" },
  ]} />
  <h3 id="vs-budget">Against the Budget, April to {period(vsPeriod, "M")}</h3>
  <div class="scroll"><table class="data">
    <thead><tr><th></th><th>₹ lakh crore so far</th><th>% of Budget Estimate</th><th>Same point last year</th></tr></thead>
    <tbody>{vsBE.map((r) => <tr><td>{r.label}</td><td>{num(r.fytd.value, 2)}</td><td>{num(r.pct.value, 1)}%</td><td>{num(r.prev.value, 1)}%</td></tr>)}</tbody>
  </table></div>
  <p class="chart-sub">Cumulative from April, so values reset each financial year. CGA cautions that the deficit in the monthly accounts during the year is not necessarily an indicator of the deficit for the full year.</p>

  <h2 id="gst">GST collections</h2>
  <div class="grid2">
    <LineChart title="GST collections" subtitle="₹ lakh crore per month" lines={[{ id: "gst_gross_collections", label: "Gross" }, { id: "gst_net_collections", label: "Net of refunds" }]} years={3} />
    <LineChart title="GST growth" subtitle="% change on the same month a year earlier (same-definition comparison)" lines={[{ id: "gst_gross_growth", label: "Gross" }, { id: "gst_net_growth", label: "Net" }]} years={3} />
  </div>
  <p class="chart-sub">GST portal statistics workbook; provisional. Gross collections in {period(gst.period, "M")}: ₹{num(gst.value, 2)} lakh crore. Each year's growth compares like with like (later months exclude compensation cess on both sides). January 2025 is missing because that month's sheet in the source workbook is malformed.</p>

  <h2 id="taxes">Tax collections by head</h2>
  <div class="grid2">
    <LineChart title="Direct taxes, year to date" subtitle="Corporate tax plus income tax, % change on the same months a year earlier"
      lines={[{ id: "cga_direct_tax_fytd", how: "yoy", label: "Direct taxes" }, { id: "cga_gross_tax_fytd", how: "yoy", label: "Gross tax revenue" }]} years={4} />
    <LineChart title="Corporate and income tax, year to date" subtitle="% change on the same months a year earlier"
      lines={[{ id: "cga_corporate_tax_fytd", how: "yoy", label: "Corporate tax" }, { id: "cga_income_tax_fytd", how: "yoy", label: "Income tax" }]} years={4} />
  </div>
  <PeriodTable heading="₹ lakh crore, April to the month shown" n={6} digits={2} rows={[
    { id: "cga_gross_tax_fytd" }, { id: "cga_direct_tax_fytd", indent: true },
    { id: "cga_corporate_tax_fytd", indent: true }, { id: "cga_income_tax_fytd", indent: true }, { id: "cga_stt_fytd", indent: true },
    { id: "cga_customs_fytd", indent: true }, { id: "cga_excise_fytd", indent: true },
  ]} />
  <PeriodTable heading="% change on the same months a year earlier" n={6} rows={[
    { id: "cga_gross_tax_fytd", how: "yoy" }, { id: "cga_direct_tax_fytd", how: "yoy", indent: true },
    { id: "cga_corporate_tax_fytd", how: "yoy", indent: true }, { id: "cga_income_tax_fytd", how: "yoy", indent: true },
    { id: "cga_customs_fytd", how: "yoy", indent: true },
  ]} />
  <p class="chart-sub">CGA monthly trend of tax revenue: gross collections by head, before the states' share is assigned. "Direct taxes" here is a site calculation, corporate tax plus taxes on income other than corporate tax; securities transaction tax is shown separately and has its own head only from FY 2023-24. Year-to-date growth in April and May swings widely because refunds can exceed collections early in the year (corporate tax was negative in April 2015 and April 2016). Excise is left out of the growth table because its April collections are close to zero (₹−39 crore in April 2025), which makes its year-to-date growth meaningless for months. Corporate tax arrives mostly in June, September, December and March (the advance-tax months: in FY 2025-26 these four months brought in about four-fifths of the year's corporate tax), so growth is best compared at those months.</p>

  <h2 id="general-government">Centre and states together</h2>
  <div class="grid2">
    <LineChart title="General government deficits" subtitle="Centre and states combined, % of GDP"
      lines={[{ id: "gg_gfd_pct_gdp", label: "Fiscal deficit" }, { id: "gg_primary_deficit_pct_gdp", label: "Primary deficit" }, { id: "gg_revenue_deficit_pct_gdp", label: "Revenue deficit" }]} years={38} />
    <LineChart title="Government debt" subtitle="Liabilities at end-March, % of GDP"
      lines={[{ id: "gg_debt_pct_gdp", label: "Centre and states combined" }, { id: "centre_debt_pct_gdp", label: "Centre" }, { id: "states_debt_pct_gdp", label: "States" }]} years={41} />
  </div>
  <p class="chart-sub">RBI's Handbook of Statistics on the Indian Economy (tables 239 and 240). The latest two years are Revised and Budget Estimates. Combined debt nets out what one level of government owes the other, so it is less than the Centre's and the states' debt added together. Each state's finances are on the <a href="/states/#finances">States</a> page.</p>

  <h2 id="twin-deficits">Twin deficits</h2>
  <figure class="chart">
    <p class="chart-title">The Centre's fiscal deficit and the current account deficit</p>
    <p class="chart-sub">% of GDP, financial year (1990 = 1990-91); both drawn as deficits, so below zero is a current account surplus</p>
    <div class="plot" data-chart={JSON.stringify(twin)}></div>
    <figcaption><span>Source: RBI, Handbook of Statistics on the Indian Economy (Tables 237 and 241).</span></figcaption>
  </figure>
  <p class="chart-sub">When the government borrows heavily and the country as a whole spends more than it earns abroad, the gap is financed by foreign capital, which can leave. Both deficits were large before the 1991 balance-of-payments crisis (1990-91: fiscal {num(fdAt(1990), 1)}%, current account {num(cadAt(1990), 1)}%) and again before the 2013 "taper tantrum" (2012-13: {num(fdAt(2012), 1)}% and {num(cadAt(2012), 1)}%). In 2020-21 they moved apart: the fiscal deficit jumped to {num(fdAt(2020), 1)}% while the current account was in surplus. The latest fiscal years are Revised and Budget Estimates; RBI computes both ratios against GDP on the base then current.</p>

</Base>
